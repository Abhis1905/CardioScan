# CardioScan Frontend Environment Configuration
# Copy this file to .env.local for local frontend development.

# Backend API URL (Production Render FastAPI or http://localhost:8000 for local backend)
REACT_APP_API_URL=https://cardioscan-api-1gbm.onrender.com

# Administrator Email (authorized for administrative dashboard routes in frontend UI)
REACT_APP_ADMIN_EMAIL=admin@example.com

# Contact/Support Email for Terms & Privacy notices
REACT_APP_CONTACT_EMAIL=contact@cardioscan.app

# Firebase Authentication Web SDK Configuration
# Required only for Google sign-in and client-side Firebase Auth.
# If unset, CardioScan gracefully falls back to native username/password auth.
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Cloudflare Turnstile Bot Protection (Public Site Key)
# Cloudflare testing sitekey (always passes): 1x00000000000000000000AA
REACT_APP_TURNSTILE_SITE_KEY=1x00000000000000000000AA

