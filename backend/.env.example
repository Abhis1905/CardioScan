# CardioScan Backend Environment Configuration

# Application Environment ('production', 'development', 'test')
ENVIRONMENT=production
DEBUG=false
PORT=8000

# Database (PostgreSQL in production requires sslmode=verify-full, SQLite fallback in development)
DATABASE_URL=postgresql://<YOUR_DB_USER>:<YOUR_DB_PASSWORD>@<YOUR_DB_HOST>:5432/cardioscan?sslmode=verify-full

# Authentication & Security
# Generate using: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_hex_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://cardio-scan-lac.vercel.app

# Frontend URL (for email verification and password reset links)
FRONTEND_URL=https://cardio-scan-lac.vercel.app

# Email Configuration (Options: 'resend', 'smtp', 'console', 'mock')
# Note: 'mock' and 'console' are rejected in production (ENVIRONMENT=production).
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here

# SENDER NOTICE FOR RESEND (WITHOUT A CUSTOM DOMAIN):
# If you do NOT own a custom domain, Resend requires using:
#   EMAIL_FROM=CardioScan <onboarding@resend.dev>
# Crucial Resend limitation without a custom domain:
#   Resend strictly delivers emails ONLY to the account owner's registered email address.
#   Attempting to send verification or password reset emails to arbitrary external users
#   will result in HTTP 403 Forbidden ("You can only send testing emails to your own email address").
#   Shared subdomains like *.vercel.app CANNOT be verified because DNS records cannot be configured on them.
#   Production delivery to arbitrary user signups requires verifying an owned custom domain in Resend.
EMAIL_FROM=CardioScan <onboarding@resend.dev>

# SMTP Fallback Configuration (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# External API Integrations
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Firebase Authentication (Zero-cost Spark Plan)
FIREBASE_PROJECT_ID=cardioscan-app
# On Render: Upload the Firebase service account JSON as a "Secret File" at /etc/secrets/firebase-service-account.json
# or set FIREBASE_SERVICE_ACCOUNT_JSON as an environment variable containing the raw JSON content.
# In local development, you may set the absolute path to your local key:
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-service-account.json
# Alternative: Raw JSON string (single-line or multiline in dashboard)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Admin Access
ADMIN_EMAIL=admin@cardioscan.app

# Cloudflare Turnstile Bot Protection
# Production requires a genuine Cloudflare Turnstile secret key.
# NEVER configure Cloudflare's published testing secret in production.
# For local development or testing only, the published test secret (always passes) may be used:
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key_here

# ML Model Artifact Integrity (SEC-03 / SEC-03.1)
# SHA-256 digest of the pre-trained model artifact bundle (models_bundle.joblib).
# IN PRODUCTION: This variable MUST be explicitly set in your deployment environment (Render, Railway, etc.).
# Silent fallback to defaults is disallowed. Automatic runtime model training is disabled in production.
# To retrain and compute a new digest locally or in CI: python scripts/retrain_model.py
MODEL_BUNDLE_SHA256=feb976cd9f101e12ef869d08c52d6d456ee666314866ae9a062fedccf688ce56

# Distributed Rate Limiting via Redis (SEC-05)
# In production: A shared Redis instance is REQUIRED to synchronize rate-limiting quotas across workers and replicas.
# In local development: Optional. If omitted, falls back to in-memory rate limiting.
REDIS_URL=redis://localhost:6379/0
