# CardioScan Backend Environment Configuration

# Application Environment ('production', 'development', 'test')
ENVIRONMENT=production
DEBUG=false
PORT=8000

# Database (PostgreSQL in production, SQLite fallback in development)
DATABASE_URL=postgresql://user:password@localhost:5432/cardioscan

# Authentication & Security
# Generate using: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_hex_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://cardio-scan-lac.vercel.app

# Frontend URL (for email verification and password reset links)
FRONTEND_URL=https://cardio-scan-lac.vercel.app

# Email Configuration (Options: 'resend', 'smtp', 'console', 'mock')
# Note: 'mock' and 'console' are rejected in production (ENVIRONMENT=production).
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here

# SENDER NOTICE FOR RESEND (WITHOUT A CUSTOM DOMAIN):
# If you do NOT own a custom domain, Resend requires using:
#   EMAIL_FROM=CardioScan <onboarding@resend.dev>
# Crucial Resend limitation without a custom domain:
#   Resend strictly delivers emails ONLY to the account owner's registered email address.
#   Attempting to send verification or password reset emails to arbitrary external users
#   will result in HTTP 403 Forbidden ("You can only send testing emails to your own email address").
#   Shared subdomains like *.vercel.app CANNOT be verified because DNS records cannot be configured on them.
#   Production delivery to arbitrary user signups requires verifying an owned custom domain in Resend.
EMAIL_FROM=CardioScan <onboarding@resend.dev>

# SMTP Fallback Configuration (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# External API Integrations
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Admin Access
ADMIN_EMAIL=admin@cardioscan.app
